# ==============================================================================
# Enterprise RAG Security & Governance Framework - Environment Template
# Copy this file to .env and replace all CHANGE_ME_* placeholders with secure values.
# Do NOT commit the .env file to version control.
# ==============================================================================

# Application Configuration
PROJECT_NAME="Enterprise RAG Security & Governance Framework"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Authentication (JWT)
# Generate a secure 32+ character key, e.g. using `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL Relational Storage
POSTGRES_USER=CHANGE_ME_POSTGRES_USER
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=CHANGE_ME_POSTGRES_DB
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# If DATABASE_URL is not set, it will be automatically assembled from the POSTGRES_* fields.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Qdrant Vector Storage
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=enterprise_knowledge_base

# Embedding Model Pipeline
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Local Host Ollama LLM Service
# When running backend locally, use http://localhost:11434.
# When running backend inside Docker Compose, use http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=2048

# Research Benchmark Experiments
DEFAULT_SAMPLE_SIZE=50
